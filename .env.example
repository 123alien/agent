APP_NAME=招投标智能核验智能体服务
DATA_DIR=./data

# Optional shared token for business-system API calls. When set, requests to
# /api/agent/* must include: X-API-Key: <token>
AGENT_API_TOKEN=
# Comma-separated browser origins. Use explicit origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Optional OpenAI-compatible LLM settings.
# Works with DeepSeek / Qwen / OpenAI-compatible gateways when configured.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_PROXY=
LLM_TIMEOUT_SECONDS=60

# Dify Workflow API settings. Leave blank to use the local agent implementation.
DIFY_BASE_URL=http://localhost:8080/v1
DIFY_COMPLIANCE_API_KEY=
# 兼容旧配置名 DIFY_API_KEY，新配置请使用上面的明确名称。
# 可选：独立的文档语义解析辅助 Workflow API Key。
DIFY_DOCUMENT_PARSER_API_KEY=
# 可选：独立的数据一致性核验 Workflow API Key。
DIFY_DATA_VALIDATOR_API_KEY=
DATA_VALIDATOR_WORKFLOW_VERSION=2.0.0
# 可选：独立的跨文件、跨主体及组合异常分析 Workflow API Key。
DIFY_ANOMALY_ANALYZER_API_KEY=
ANOMALY_ANALYZER_WORKFLOW_VERSION=2.0.0
REPORT_GENERATOR_WORKFLOW_VERSION=2.0.0
# 可选：合同模板选择、字段语义映射和补充条款草拟 Workflow API Key。
# 未配置时自动使用本地确定性模板，不影响合同生成。
DIFY_REPORT_GENERATOR_API_KEY=
DIFY_TIMEOUT_SECONDS=120
# 文档语义解析失败时应快速降级到本地解析，避免单个文件阻塞数分钟。
DIFY_DOCUMENT_PARSER_TIMEOUT_SECONDS=45
RAG_CACHE_TTL_SECONDS=604800
COMPLIANCE_WORKFLOW_VERSION=2.2.0
RULESET_VERSION=1.0.0

# 远程文件接入设置。多个域名使用英文逗号分隔；留空表示不限制主机。
REMOTE_FILE_ALLOWED_HOSTS=
REMOTE_FILE_TIMEOUT_SECONDS=30
REMOTE_FILE_MAX_BYTES=52428800

# 任务完成回调设置。正式环境建议配置允许回调的业务系统域名。
CALLBACK_ALLOWED_HOSTS=
CALLBACK_TIMEOUT_SECONDS=10
# Visual document analysis
VISUAL_ANALYSIS_ENABLED=true
VISUAL_ANALYSIS_MAX_PAGES=100
VISUAL_REVIEW_THRESHOLD=0.80
VISUAL_DETECTOR_MODEL_PATH=
